.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# --- Python ---
# El entorno virtual NUNCA va al repositorio: adentro tiene rutas absolutas
# de la maquina donde se creo (pyvenv.cfg y los .exe de Scripts/ apuntan al
# interprete de ESA maquina), asi que en la otra PC no arranca. Cada uno
# crea el suyo con pc/requirements.txt, que es lo que si se comparte.
.venv/
venv/
__pycache__/
*.py[cod]

# Configuracion local de la aplicacion de PC: puerto COM, indice de camara
# y calibracion de esta maquina. Es distinta en cada PC a proposito.
pc/config/local.json

# Las secuencias de teach que todavia tienen el nombre de fabrica
# ("Movimiento 7"): descarte de una tarde de pruebas. Las que valen la pena
# se renombran, y esas si van al repositorio, en movimientos.json. El reparto
# lo hace sola la aplicacion al guardar (kuko/teach.py, es_local).
pc/config/movimientos_locales.json

# Medicion temporal de formas (LOG_FORMAS en vision_python/config.py).
# Se borra junto con esa bandera.
formas_medidas.csv
formas_medidas_produccion.csv
